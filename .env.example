# Absolute origin the site is served from, no trailing slash.
# Required for canonical URLs, og:image and the sitemap — social cards will not
# render without it. The build warns and omits canonical/og:url if unset.
VITE_SITE_URL=https://www.body-fans.com

# --- Firebase ---------------------------------------------------------------
# Copy these from the Firebase console (Project settings > Your apps).
# They are NOT secrets: every Firebase web app ships them in its bundle. They
# identify the project; firestore.rules is what actually protects the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Clients log in with a username; this is the domain their synthetic email uses.
VITE_CLIENT_EMAIL_DOMAIN=clients.body-fans.com

# 1 routes the app at the local emulators (npm run emulators).
VITE_USE_EMULATORS=0
